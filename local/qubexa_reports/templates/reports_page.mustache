<section class="qubexa-reports" aria-labelledby="qubexa-reports-overview">
    <header class="qubexa-reports__header">
        <div>
            <span class="qubexa-reports__eyebrow">Hocadex</span>
            <h2 id="qubexa-reports-overview">{{overviewtitle}}</h2>
            <p>{{overviewdesc}}</p>
        </div>
    </header>

    <div class="qubexa-reports__metrics">
        {{#metrics}}
            <article class="qubexa-reports__metric {{tone}}">
                <span>{{label}}</span>
                <strong>{{value}}</strong>
            </article>
        {{/metrics}}
    </div>

    <section class="qubexa-reports__panel" aria-labelledby="qubexa-participation-title">
        <header class="qubexa-reports__panel-header">
            <div>
                <h3 id="qubexa-participation-title">{{participationtitle}}</h3>
                <p>{{participationdesc}}</p>
            </div>

            <div class="qubexa-reports__panel-actions">
                {{#hasclassoptions}}
                    <form class="qubexa-reports__filter" action="{{filterurl}}" method="get">
                        <input type="hidden" name="page" value="reports">

                        <div class="qubexa-reports__filter-fields">
                            <div class="qubexa-reports__filter-field">
                                <label for="qubexa-report-class">{{classfilterlabel}}</label>
                                <select id="qubexa-report-class" name="reportclassid">
                                    <option value="0">{{allclasseslabel}}</option>
                                    {{#classoptions}}
                                        <option value="{{id}}" {{#selected}}selected{{/selected}}>
                                            {{label}}
                                        </option>
                                    {{/classoptions}}
                                </select>
                            </div>

                            <div class="qubexa-reports__filter-field is-search">
                                <label for="qubexa-report-student">{{studentfilterlabel}}</label>
                                <input
                                    id="qubexa-report-student"
                                    name="reportstudent"
                                    type="search"
                                    value="{{studentquery}}"
                                    maxlength="100"
                                    placeholder="{{studentplaceholder}}"
                                >
                            </div>

                            <div class="qubexa-reports__filter-field">
                                <label for="qubexa-report-date-from">{{datefromlabel}}</label>
                                <input
                                    id="qubexa-report-date-from"
                                    name="reportdatefrom"
                                    type="date"
                                    value="{{datefrom}}"
                                >
                            </div>

                            <div class="qubexa-reports__filter-field">
                                <label for="qubexa-report-date-to">{{datetolabel}}</label>
                                <input
                                    id="qubexa-report-date-to"
                                    name="reportdateto"
                                    type="date"
                                    value="{{dateto}}"
                                >
                            </div>
                        </div>

                        <div class="qubexa-reports__filter-actions">
                            <button type="submit">{{applyfilterlabel}}</button>

                            {{#hasfilter}}
                                <a href="{{reseturl}}">{{clearfilterlabel}}</a>
                            {{/hasfilter}}
                        </div>
                    </form>
                {{/hasclassoptions}}

                {{#hasrows}}
                    <a class="qubexa-reports__export" href="{{exporturl}}">
                        <span aria-hidden="true">↓</span>
                        {{exportcsvlabel}}
                    </a>
                {{/hasrows}}
            </div>
        </header>

        {{#hasrows}}
            <div class="qubexa-reports__table-wrap">
                <table class="qubexa-reports__table">
                    <thead>
                        <tr>
                            <th scope="col">{{studentlabel}}</th>
                            <th scope="col">{{classlabel}}</th>
                            <th scope="col">{{pluslabel}}</th>
                            <th scope="col">{{minuslabel}}</th>
                            <th scope="col">{{netlabel}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                <td data-label="{{studentlabel}}">
                                    <strong>{{fullname}}</strong>
                                    {{#hasstudentnumber}}
                                        <small>{{studentnumberlabel}}: {{studentnumber}}</small>
                                    {{/hasstudentnumber}}
                                </td>
                                <td data-label="{{classlabel}}">
                                    <a href="{{classurl}}">{{classname}}</a>
                                </td>
                                <td data-label="{{pluslabel}}" class="is-plus">+{{pluscount}}</td>
                                <td data-label="{{minuslabel}}" class="is-minus">−{{minuscount}}</td>
                                <td data-label="{{netlabel}}">
                                    <span class="qubexa-reports__net {{netclass}}">{{net}}</span>
                                </td>
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        {{/hasrows}}

        {{^hasrows}}
            <div class="qubexa-reports__empty">
                <span aria-hidden="true">▥</span>
                <h3>{{emptytitle}}</h3>
                <p>{{emptydesc}}</p>
            </div>
        {{/hasrows}}
    </section>
</section>
